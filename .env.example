# AI Code Change Agent: environment contract (safe to commit; placeholders only).
# Copy to .env and fill in. Never commit .env. Secrets are marked [secret].
# Full reference: docs/CONFIGURATION.md

# ---- Application --------------------------------------------------------------------------
APP_ENV=development                 # development | test | staging | production
APP_NAME=ai-code-change-agent
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true

# ---- Database (independent PostgreSQL; compose service on 127.0.0.1:5435) ------------------
DATABASE_URL=postgresql+psycopg://acca:acca_dev_only@127.0.0.1:5435/ai_code_change_agent
LANGGRAPH_CHECKPOINT_SCHEMA=langgraph   # workflow checkpoints, separate from domain tables

# ---- Jira (webhook intake, read-only REST, optional outcome comment) -------------------------
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=automation@example.com
JIRA_API_TOKEN=                     # [secret] Atlassian API token (read; comment only if reporting)
JIRA_WEBHOOK_SECRET=                # [secret] HMAC secret configured on the Jira webhook
JIRA_PROJECT_KEYS=SHOP              # comma-separated; webhook scope (the registry mapping authorises)
JIRA_STORY_ISSUE_TYPES=Story
JIRA_WEBHOOK_EVENT=jira:issue_created
JIRA_REPOSITORY_FIELD=              # optional custom field id holding the repository reference
JIRA_REPORTING_ENABLED=false        # one outcome comment with the draft PR URL; off by default

# ---- GitHub App (the installation's selected repositories are the access boundary) -----------
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=        # absolute path to the PEM file (mode 0600, owned by you)

# ---- Delivery (both must be true for a draft PR; plus a final approval) ----------------------
CODE_CHANGE_DELIVERY_ENABLED=false
GITHUB_PR_CREATE_ENABLED=false

# ---- LLM / Deep Agent ---------------------------------------------------------------------
LLM_PROVIDER=anthropic              # anthropic (local development/tests) | bedrock (staging/production, required there)
LLM_MODEL=                          # e.g. claude-haiku-5-5 (anthropic) or a Bedrock model/inference-profile id
ANTHROPIC_API_KEY=                  # [secret] anthropic only
BEDROCK_REGION=                     # bedrock only, e.g. us-east-1 (beta/production on AWS)
BEDROCK_CREDENTIALS_PROFILE=        # optional AWS profile; credentials come from the worker's AWS chain
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=8192
DEEP_AGENT_RECURSION_LIMIT=250
DEEP_AGENT_EXECUTE_TIMEOUT_SECONDS=300   # per sandbox command

# ---- Execution sandbox and artifacts -------------------------------------------------------
WORKSPACE_ROOT=/absolute/path/to/ai-code-change-agent/var/workspaces
ARTIFACT_ROOT=/absolute/path/to/ai-code-change-agent/var/artifacts
WORKSPACE_IMAGE=ai-code-change-agent/execution-python:0.2.0
WORKSPACE_CPU_LIMIT=1.0
WORKSPACE_MEMORY_LIMIT_MB=2048
WORKSPACE_PIDS_LIMIT=256
WORKSPACE_DISK_LIMIT_MB=1024
WORKSPACE_TIMEOUT_SECONDS=7200      # maximum life of one sandbox container
WORKSPACE_NETWORK_POLICY=none       # the only supported value

# ---- Jobs and workflow ----------------------------------------------------------------------
MAX_CONCURRENT_JOBS=2
JOB_LEASE_SECONDS=300
JOB_HEARTBEAT_SECONDS=60
JOB_MAX_ATTEMPTS=3
MAX_REPAIR_ATTEMPTS=1

# ---- Automated pipeline (docs/AUTOMATED-PIPELINE.md) ----------------------------------------
WORKFLOW_APPROVAL_MODE=automatic          # automatic | manual (operator CLI gates)
DEPENDENCY_INDEX_URL=https://pypi.org/simple
DEPENDENCY_MAX_PACKAGES=60
DEPENDENCY_MAX_BYTES=314572800
DEPENDENCY_TIMEOUT_SECONDS=600
DEPENDENCY_ALLOW_UNVERIFIED_INDEX=false   # allow package indexes that cannot supply independent metadata hashes (default: false)
DEPENDENCY_RESOLVER_NETWORK=aica-dep-resolver  # --internal Docker network of the resolver (created if missing); only exit is the allow-list proxy
# official documentation the agent may search and read (empty = no research tools); verified set:
# docs.python.org,fastapi.tiangolo.com,docs.langchain.com,platform.claude.com,docs.aws.amazon.com,www.postgresql.org,docs.sqlalchemy.org,docs.docker.com,docs.github.com,developer.atlassian.com,docs.astral.sh,docs.pytest.org
REFERENCE_ALLOWED_DOMAINS=
REFERENCE_MAX_FETCHES=20
DEEP_AGENT_RUN_TIMEOUT_SECONDS=5400

# ---- LangSmith tracing (worker only; off by default) ----------------------------------------
# Story text and repository content appear in traces unless the HIDE flags are true.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=                        # [secret]
LANGSMITH_ENDPOINT=                       # region/self-hosted API URL (empty = US cloud)
LANGSMITH_WORKSPACE_ID=                   # when the key can reach several workspaces
LANGSMITH_AGENT_ID=                       # agent-based workspace, with LANGSMITH_AGENT_ENVIRONMENT
LANGSMITH_AGENT_ENVIRONMENT=local         # local | development | staging | production
LANGSMITH_PROJECT=                        # project-based workspace (never together with the agent id)
LANGSMITH_HIDE_INPUTS=false
LANGSMITH_HIDE_OUTPUTS=false

# ---- Model pacing and context ---------------------------------------------------------------
LLM_CONTEXT_TOKENS=128000                 # model input window: drives summarisation (85%) and tool-output trimming (50%)
LLM_REQUESTS_PER_MINUTE=                  # client-side pacing in requests/minute (empty = unlimited)

# ---- LLM cost tracking (docs/LLM-COST-TRACKING.md) ----------------------------------------
LLM_PRICING_FILE=                         # optional JSON price list (absolute path); empty = built-in table

# ---- Multi-repository, toolchains, research and cost guards ------------------------
MULTI_REPO_MAX_REPOSITORIES=5
REFERENCE_SEARCH_ENABLED=true             # search_docs via Anthropic web search (anthropic provider only)
REFERENCE_MAX_SEARCHES=5
DEEP_AGENT_MAX_MODEL_CALLS=80             # per agent phase run, any model
LLM_MAX_COST_PER_PHASE_USD=2.0            # per agent phase run, any priced model
